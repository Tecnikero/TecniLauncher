<Window x:Class="TecniLauncher.VentanaConsentimiento"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Consent_Title}" Width="540" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#EDEEF0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnPrimario" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#5B8CFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7AA2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnSecundario" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#1E2127"/>
            <Setter Property="BorderBrush" Value="#2E323A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#23262D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#121418" BorderBrush="#2E323A" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="4" Height="16" CornerRadius="2" Background="#5B8CFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{DynamicResource Consent_Title}" Foreground="#EDEEF0" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <TextBlock Text="{DynamicResource Consent_Intro}" Foreground="#B4B9C1" TextWrapping="Wrap" FontSize="13" LineHeight="19"/>
                <TextBlock Text="{DynamicResource Consent_SentTitle}" Foreground="#EDEEF0" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,2"/>
                <TextBlock Text="{DynamicResource Consent_Sent}" Foreground="#B4B9C1" TextWrapping="Wrap" FontSize="12.5" LineHeight="18"/>
                <TextBlock Text="{DynamicResource Consent_NeverTitle}" Foreground="#EDEEF0" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,2"/>
                <TextBlock Text="{DynamicResource Consent_Never}" Foreground="#B4B9C1" TextWrapping="Wrap" FontSize="12.5" LineHeight="18"/>
                <TextBlock Text="{DynamicResource Consent_Control}" Foreground="#B4B9C1" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Margin="0,12,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Margin="0,12,0,0" FontSize="12.5">
                <Hyperlink NavigateUri="https://tecnistudio.online/privacidad.html" RequestNavigate="Enlace_RequestNavigate" Foreground="#7AA2FF">
                    <Run Text="{DynamicResource Settings_PrivacyPolicy}"/>
                </Hyperlink>
            </TextBlock>

            <!-- Los dos botones tienen el mismo peso visual: ninguna opción está preseleccionada. -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="btnNoParticipar" Content="{DynamicResource Consent_Decline}" Style="{StaticResource BtnSecundario}" Margin="0,0,8,0" Click="BtnNoParticipar_Click"/>
                <Button x:Name="btnAceptar" Content="{DynamicResource Consent_Accept}" Style="{StaticResource BtnSecundario}" Click="BtnAceptar_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
