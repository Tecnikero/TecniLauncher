<Window x:Class="TecniLauncher.VentanaMensaje"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aviso" Height="210" Width="460"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" Topmost="True">

    <Window.Resources>
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#EDEEF0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnPrimario" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#5B8CFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7AA2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnSecundario" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#1E2127"/>
            <Setter Property="BorderBrush" Value="#2E323A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#23262D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#121418" BorderBrush="#2E323A" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="22,20,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="4" Height="16" CornerRadius="2" Background="#5B8CFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="txtTitulo" Text="CONFIRMACIÓN" Foreground="#EDEEF0" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="txtMensaje" Grid.Row="1" Text="¿Estás seguro?"
                       Foreground="#B4B9C1" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" LineHeight="19" Margin="0,10"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancelar" Content="CANCELAR" Style="{StaticResource BtnSecundario}" Margin="0,0,8,0"
                        Visibility="Collapsed" Click="BtnCancelar_Click"/>
                <Button x:Name="btnAceptar" Content="ACEPTAR" Style="{StaticResource BtnPrimario}" Click="BtnAceptar_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
