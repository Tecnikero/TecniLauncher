<Window x:Class="TecniLauncher.VentanaBienvenida"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeroLauncher" Width="560" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="BtnPrimario" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="26,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#5B8CFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7AA2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Punto" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B4B9C1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#121418" BorderBrush="#2E323A" BorderThickness="1" Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <StackPanel Margin="30,28,30,24">
            <TextBlock FontSize="30" FontWeight="Bold" Foreground="#F2F4F8">
                <Run Text="Kero"/><Run Text="Launcher" Foreground="#5B8CFF"/>
            </TextBlock>
            <TextBlock Text="by TecniStudio" Foreground="#7C8290" FontSize="12" Margin="1,0,0,14"/>

            <TextBlock Text="{DynamicResource Welcome_Title}" Foreground="#EDEEF0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource Welcome_Intro}" Style="{StaticResource Punto}" Margin="0,6,0,16"/>

            <Border Background="#17191E" BorderBrush="#24272E" BorderThickness="1" CornerRadius="10" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Welcome_NewTitle}" Foreground="#5B8CFF" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Welcome_Item1}" Style="{StaticResource Punto}" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource Welcome_Item2}" Style="{StaticResource Punto}" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource Welcome_Item3}" Style="{StaticResource Punto}" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource Welcome_Item4}" Style="{StaticResource Punto}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{DynamicResource Welcome_Safe}" Foreground="#7C8290" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,18"/>

            <Button Content="{DynamicResource Welcome_Start}" Style="{StaticResource BtnPrimario}" HorizontalAlignment="Right" Click="BtnEmpezar_Click" IsDefault="True"/>
        </StackPanel>
    </Border>
</Window>
