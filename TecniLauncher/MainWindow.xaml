<Window x:Class="TecniLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
        Title="TecniLauncher"
        Height="650" Width="1000"
        MinHeight="600" MinWidth="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Esquina entre barras de desplazamiento (por defecto es gris claro) -->
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>

        <!-- ═════════════════════ PALETA ═════════════════════ -->
        <SolidColorBrush x:Key="ColorAccent" Color="#5B8CFF"/>
        <SolidColorBrush x:Key="ColorAccentHover" Color="#7AA2FF"/>
        <SolidColorBrush x:Key="ColorAccentDim" Color="#245B8CFF"/>
        <SolidColorBrush x:Key="BgDark" Color="#0E0F12"/>
        <SolidColorBrush x:Key="BgSidebar" Color="#121418"/>
        <SolidColorBrush x:Key="BgCard" Color="#17191E"/>
        <SolidColorBrush x:Key="BgCardAlt" Color="#1E2127"/>
        <SolidColorBrush x:Key="BgHover" Color="#23262D"/>
        <SolidColorBrush x:Key="BgInput" Color="#121418"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#22252B"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#2E323A"/>
        <SolidColorBrush x:Key="TextMain" Color="#EDEEF0"/>
        <SolidColorBrush x:Key="TextSub" Color="#8A9099"/>
        <SolidColorBrush x:Key="TextMuted" Color="#5C626C"/>
        <SolidColorBrush x:Key="ColorSuccess" Color="#22C55E"/>
        <SolidColorBrush x:Key="ColorDanger" Color="#F05252"/>
        <SolidColorBrush x:Key="ColorWarning" Color="#F5A524"/>

        <!-- Colores por sección -->
        <SolidColorBrush x:Key="ColPlay" Color="#5B8CFF"/>
        <SolidColorBrush x:Key="ColPlayDim" Color="#265B8CFF"/>
        <SolidColorBrush x:Key="ColProfiles" Color="#F5A524"/>
        <SolidColorBrush x:Key="ColProfilesDim" Color="#26F5A524"/>
        <SolidColorBrush x:Key="ColMods" Color="#A07CFF"/>
        <SolidColorBrush x:Key="ColModsDim" Color="#26A07CFF"/>
        <SolidColorBrush x:Key="ColModpacks" Color="#2EC4B6"/>
        <SolidColorBrush x:Key="ColModpacksDim" Color="#262EC4B6"/>
        <SolidColorBrush x:Key="ColClient" Color="#F472B6"/>
        <SolidColorBrush x:Key="ColClientDim" Color="#26F472B6"/>
        <SolidColorBrush x:Key="ColSettings" Color="#94A3B8"/>
        <SolidColorBrush x:Key="ColSettingsDim" Color="#2694A3B8"/>

        <!-- Plataformas y tipos -->
        <SolidColorBrush x:Key="ColModrinth" Color="#3FA66B"/>
        <SolidColorBrush x:Key="ColCurseForge" Color="#E06A35"/>
        <SolidColorBrush x:Key="ColTexturas" Color="#38BDF8"/>
        <SolidColorBrush x:Key="ColShaders" Color="#F5A524"/>
        <SolidColorBrush x:Key="ColConsola" Color="#22C55E"/>

        <!-- ═════════════════════ ICONOS (24x24, trazo) ═════════════════════ -->
        <Geometry x:Key="IcoPlay">M8,5 L19,12 L8,19 Z</Geometry>
        <Geometry x:Key="IcoProfiles">M12,3 L21,8 L12,13 L3,8 Z M3,12.5 L12,17.5 L21,12.5 M3,16.5 L12,21.5 L21,16.5</Geometry>
        <Geometry x:Key="IcoMods">M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z</Geometry>
        <Geometry x:Key="IcoModpacks">M12,2.5 L20.5,7 V17 L12,21.5 L3.5,17 V7 Z M3.5,7 L12,11.5 L20.5,7 M12,11.5 V21.5</Geometry>
        <Geometry x:Key="IcoBolt">M13,2 L4,14 H12 L11,22 L20,10 H12 Z</Geometry>
        <Geometry x:Key="IcoSettings">M4,6 H13 M17,6 H20 M4,12 H7 M11,12 H20 M4,18 H11 M15,18 H20 M15,4 V8 M9,10 V14 M13,16 V20</Geometry>
        <Geometry x:Key="IcoPlus">M12,5 V19 M5,12 H19</Geometry>
        <Geometry x:Key="IcoDownload">M12,4 V15 M7,10 L12,15 L17,10 M5,20 H19</Geometry>
        <Geometry x:Key="IcoSearch">M4,11 A7,7 0 1 1 18,11 A7,7 0 1 1 4,11 Z M16,16 L20,20</Geometry>
        <Geometry x:Key="IcoEdit">M4,20 H8 L19,9 L15,5 L4,16 Z M13,7 L17,11</Geometry>
        <Geometry x:Key="IcoFolder">M3,7 C3,5.9 3.9,5 5,5 H9 L11,7 H19 C20.1,7 21,7.9 21,9 V17 C21,18.1 20.1,19 19,19 H5 C3.9,19 3,18.1 3,17 Z</Geometry>
        <Geometry x:Key="IcoShare">M12,15 V3 M7,8 L12,3 L17,8 M5,13 V19 H19 V13</Geometry>
        <Geometry x:Key="IcoTrash">M4,7 H20 M9,7 V4 H15 V7 M6,7 L7,20 H17 L18,7 M10,11 V16 M14,11 V16</Geometry>
        <Geometry x:Key="IcoChevronLeft">M15,5 L8,12 L15,19</Geometry>
        <Geometry x:Key="IcoChevronRight">M9,5 L16,12 L9,19</Geometry>
        <Geometry x:Key="IcoBack">M19,12 H5 M11,6 L5,12 L11,18</Geometry>
        <Geometry x:Key="IcoUser">M8,8 A4,4 0 1 1 16,8 A4,4 0 1 1 8,8 Z M4,21 C4,16.6 7.6,14 12,14 C16.4,14 20,16.6 20,21</Geometry>
        <Geometry x:Key="IcoClock">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M12,7 V12 L15,14</Geometry>
        <Geometry x:Key="IcoReset">M4,12 A8,8 0 1 0 6.3,6.3 M4,4 V9 H9</Geometry>
        <Geometry x:Key="IcoUpload">M12,15 V4 M7,9 L12,4 L17,9 M4,17 V20 H20 V17</Geometry>

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        </Style>

        <!-- ═════════════════════ TEXTOS ═════════════════════ -->
        <Style x:Key="TxtPageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="TxtPageSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TxtSection" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>
        <Style x:Key="TxtField" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>
        <Style x:Key="TxtRowTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="TxtRowDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ═════════════════════ CONTENEDORES ═════════════════════ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="ModalCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgSidebar}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Segmented" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="{StaticResource BorderSoft}"/>
            <Setter Property="Margin" Value="0,14"/>
        </Style>

        <!-- ═════════════════════ BOTONES ═════════════════════ -->
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource BgCardAlt}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.75"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ColorAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ColorAccentHover}"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón sólido con color de sección: se le pone Background en el propio botón -->
        <Style x:Key="BtnTinted" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BgCardAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgHover}"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1FF05252"/>
            <Setter Property="Foreground" Value="#FF7A7A"/>
            <Setter Property="BorderBrush" Value="#40F05252"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33F05252"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnIcon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{StaticResource BgCardAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnChrome" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnChromeClose" TargetType="Button" BasedOn="{StaticResource BtnChrome}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5484D"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═════════════════════ MENÚ LATERAL ═════════════════════ -->
        <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="NavPrincipal"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- El color de cada sección llega por Background -->
                        <Border x:Name="bdr" Background="Transparent" CornerRadius="9">
                            <Grid>
                                <Border x:Name="tinte" CornerRadius="9" Background="{TemplateBinding Background}" Opacity="0"/>
                                <Border x:Name="indicador" Width="3" Height="18" CornerRadius="1.5" Background="{TemplateBinding Background}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,12,0">
                                    <Grid Width="28" Height="28">
                                        <Border x:Name="chip" CornerRadius="8" Background="{TemplateBinding Background}" Opacity="0.14"/>
                                        <Viewbox Width="16" Height="16">
                                            <Canvas Width="24" Height="24">
                                                <Path x:Name="ico" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Stroke="{TemplateBinding Background}" StrokeThickness="2.2"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                    <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{StaticResource BgHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tinte" Property="Opacity" Value="0.13"/>
                                <Setter TargetName="indicador" Property="Opacity" Value="1"/>
                                <Setter TargetName="chip" Property="Opacity" Value="0.25"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selector segmentado (Mods/Texturas/Shaders, Modrinth/CurseForge, Noticias/Consola) -->
        <Style x:Key="TipoComplementoStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bdr" Background="Transparent" CornerRadius="7" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{StaticResource BgHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selector segmentado con color propio (el color llega por Background) -->
        <Style x:Key="SegColor" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="tinte" CornerRadius="7" Background="{TemplateBinding Background}" Opacity="0"/>
                            <Border x:Name="borde" CornerRadius="7" BorderBrush="{TemplateBinding Background}" BorderThickness="1" Opacity="0"/>
                            <StackPanel Orientation="Horizontal" Margin="12,6,14,6" HorizontalAlignment="Center">
                                <Ellipse x:Name="punto" Width="7" Height="7" Fill="{TemplateBinding Background}" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                                <Setter TargetName="tinte" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tinte" Property="Opacity" Value="0.2"/>
                                <Setter TargetName="borde" Property="Opacity" Value="0.55"/>
                                <Setter TargetName="punto" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icono de cabecera de página (color por Background, icono por Tag) -->
        <Style x:Key="PageIcon" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid Width="40" Height="40">
                            <Border CornerRadius="11" Background="{TemplateBinding Background}" Opacity="0.16"/>
                            <Border CornerRadius="11" BorderBrush="{TemplateBinding Background}" BorderThickness="1" Opacity="0.35"/>
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Background}" StrokeThickness="2.2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pestañas subrayadas -->
        <Style x:Key="TabUnderline" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bdr" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="2,10" Margin="0,0,22,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource ColMods}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════════════════ INTERRUPTORES ═════════════════════ -->
        <Style x:Key="SwitchModStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="22" Background="Transparent">
                            <Border x:Name="FondoSwitch" CornerRadius="11" Background="#2A2E36"/>
                            <Ellipse x:Name="BotonCirculo" Fill="#C9CDD4" Width="16" Height="16" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="FondoSwitch" Property="Background" Value="{StaticResource ColorAccent}"/>
                                <Setter TargetName="BotonCirculo" Property="Fill" Value="White"/>
                                <Setter TargetName="BotonCirculo" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="BotonCirculo" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FondoSwitch" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fila de ajustes: contenido a la izquierda, interruptor a la derecha -->
        <Style x:Key="SettingSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <Grid Grid.Column="1" Width="40" Height="22" VerticalAlignment="Center">
                                <Border x:Name="FondoSwitch" CornerRadius="11" Background="#2A2E36"/>
                                <Ellipse x:Name="BotonCirculo" Fill="#C9CDD4" Width="16" Height="16" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="FondoSwitch" Property="Background" Value="{StaticResource ColorAccent}"/>
                                <Setter TargetName="BotonCirculo" Property="Fill" Value="White"/>
                                <Setter TargetName="BotonCirculo" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="BotonCirculo" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FondoSwitch" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Casilla simple -->
        <Style x:Key="CheckPlain" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="caja" Width="16" Height="16" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{StaticResource BorderStrong}" Background="{StaticResource BgCardAlt}" VerticalAlignment="Center">
                                <Path x:Name="marca" Data="M3.5,8 L6.5,11 L12.5,4.5" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="caja" Property="Background" Value="{StaticResource ColorAccent}"/>
                                <Setter TargetName="caja" Property="BorderBrush" Value="{StaticResource ColorAccent}"/>
                                <Setter TargetName="marca" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════════════════ ENTRADAS ═════════════════════ -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMain}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource ColorAccent}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#3A3F48"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource ColorAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMain}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource ColorAccent}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#3A3F48"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource ColorAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ColorAccentDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#3A3F48"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ColorAccent}"/>
                                                <Setter TargetName="Arrow" Property="Data" Value="M 0,4 L 4,0 L 8,4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="{StaticResource BgCardAlt}" BorderThickness="1" BorderBrush="{StaticResource BorderStrong}" CornerRadius="10" Margin="0,4,0,0">
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider -->
        <Style x:Key="SliderRepeatFill" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{StaticResource ColorAccent}" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderRepeatEmpty" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#2A2E36" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid MinHeight="20" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderRepeatFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeatEmpty}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="pomo" Width="16" Height="16" Fill="White" Stroke="{StaticResource ColorAccent}" StrokeThickness="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="pomo" Property="StrokeThickness" Value="4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barras de desplazamiento finas -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="t" CornerRadius="3" Background="#2E323A" Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="Background" Value="#434852"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="t" Property="Background" Value="#555B66"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource ColorAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{StaticResource BgCardAlt}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="6" Padding="9,5">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Contenedor de elemento de lista sin cromado -->
        <Style x:Key="ItemPlano" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RaizContenido">
        <Border CornerRadius="12" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════════════════════════ BARRA LATERAL ═══════════════════════════ -->
                <Border Grid.Column="0" Background="{StaticResource BgSidebar}" CornerRadius="11,0,0,11"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Marca -->
                        <StackPanel Grid.Row="0" Margin="24,24,20,26" Background="Transparent" MouseLeftButtonDown="MoverVentana_MouseDown">
                            <TextBlock Foreground="{StaticResource TextMain}" FontSize="21" FontWeight="Bold">
                                <Run Text="Tecni"/><Run Text="Launcher" Foreground="{StaticResource ColorAccent}"/>
                            </TextBlock>
                            <TextBlock x:Name="TxtVersion" Text="v1.0.0" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="1,2,0,0"/>
                        </StackPanel>

                        <!-- Navegación -->
                        <StackPanel Grid.Row="1" Margin="12,0">
                            <RadioButton x:Name="MenuJugarBtn" Content="{DynamicResource Menu_Play}" Tag="{StaticResource IcoPlay}" Background="{StaticResource ColPlay}" Style="{StaticResource MenuButtonStyle}" Click="MenuJugar_Click" IsChecked="True"/>
                            <RadioButton Content="{DynamicResource Menu_Profiles}" Tag="{StaticResource IcoProfiles}" Background="{StaticResource ColProfiles}" Style="{StaticResource MenuButtonStyle}" Click="MenuPerfiles_Click"/>
                            <RadioButton Content="{DynamicResource Menu_Mods}" Tag="{StaticResource IcoMods}" Background="{StaticResource ColMods}" Style="{StaticResource MenuButtonStyle}" Click="MenuMods_Click"/>
                            <RadioButton Content="{DynamicResource Menu_ModPacks}" Tag="{StaticResource IcoModpacks}" Background="{StaticResource ColModpacks}" Style="{StaticResource MenuButtonStyle}" Click="MenuModpacks_Click"/>
                            <RadioButton Content="TecniClient" Tag="{StaticResource IcoBolt}" Background="{StaticResource ColClient}" Style="{StaticResource MenuButtonStyle}" Click="MenuTecniClients_Click"/>

                            <Rectangle Style="{StaticResource Divider}" Margin="8,12"/>

                            <RadioButton Content="{DynamicResource Menu_Settings}" Tag="{StaticResource IcoSettings}" Background="{StaticResource ColSettings}" Style="{StaticResource MenuButtonStyle}" Click="MenuAjustes_Click"/>
                        </StackPanel>

                        <!-- Tarjeta de usuario -->
                        <Border Grid.Row="2" Margin="12,0,12,10" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="imgAvatar" Width="34" Height="34" Fill="#2A2E36" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock x:Name="txtUsuario" Grid.Column="1" Text="{DynamicResource Login_NoSession}" Foreground="{StaticResource TextMain}"
                                           FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Content="{DynamicResource Btn_Login}" Style="{StaticResource BtnSecondary}" Height="30" Padding="10,0" FontSize="11" FontWeight="Bold" Click="AbrirLogin_Click"/>
                            </Grid>
                        </Border>

                        <!-- Enlaces -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="16,0,16,14">
                            <Button Style="{StaticResource BtnGhost}" Width="34" Height="34" Padding="0" Click="BtnDiscord_Click" ToolTip="Discord">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="17" Height="17"
                                      Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1432-.1064.2868-.2132.4233-.3241a.0746.0746 0 00.0235-.0814c3.9204 1.7933 8.18 1.7933 12.0614 0a.0738.0738 0 00.024.0821c.1367.111.2803.2177.4233.3241a.076.076 0 01-.0077.1277 12.2946 12.2946 0 01-1.8722.8923.077.077 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6066 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0551c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.419-2.1568 2.419zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.419-2.1568 2.419z"/>
                            </Button>
                            <Button Style="{StaticResource BtnGhost}" Width="34" Height="34" Padding="0" Margin="4,0,0,0" Click="BtnGithub_Click" ToolTip="GitHub">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="17" Height="17"
                                      Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.419-1.305.763-1.605-2.665-.3-5.466-1.332-5.466-5.930 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════ CONTENIDO ═══════════════════════════ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barra de título -->
                    <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="MoverVentana_MouseDown" Panel.ZIndex="100">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Button Content="—" Style="{StaticResource BtnChrome}" Click="Minimizar_Click"/>
                            <Button x:Name="btnMaximizar" Content="☐" Style="{StaticResource BtnChrome}" FontSize="14" Margin="2,0" Click="Maximizar_Click"/>
                            <Button Content="✕" Style="{StaticResource BtnChromeClose}" Click="Cerrar_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- ─────────────── TECNICLIENT ─────────────── -->
                    <Grid x:Name="vistaTecniClients" Grid.Row="1" Visibility="Collapsed" Margin="32,4,32,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,22" Orientation="Horizontal">
                            <ContentControl Style="{StaticResource PageIcon}" Background="{StaticResource ColClient}" Tag="{StaticResource IcoBolt}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TecniClient" Style="{StaticResource TxtPageTitle}"/>
                                <TextBlock Text="{DynamicResource client_des}" Style="{StaticResource TxtPageSub}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ListTecniClients">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="TarjetaClient" Width="250" Margin="0,0,14,14" Background="{StaticResource BgCard}" CornerRadius="14" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                                            <StackPanel Margin="16">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource ColClientDim}">
                                                        <TextBlock Text="{Binding Icon}" FontSize="24" Foreground="{StaticResource ColClient}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                        <Border Background="{StaticResource ColClientDim}" CornerRadius="5" Padding="6,1" Margin="0,4,0,0" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Version}" Foreground="{StaticResource ColClient}" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSub}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>

                                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Mods}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource BgCardAlt}" CornerRadius="5" Padding="7,2" Margin="0,0,5,5">
                                                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Border Margin="0,8,0,0" Background="{StaticResource BgSidebar}" CornerRadius="9" Padding="12,9">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,4">
                                                            <TextBlock Text="RAM" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding SelectedRam, StringFormat=\{0\} GB}" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <Slider Minimum="1" Maximum="16" Value="{Binding SelectedRam, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                                    </StackPanel>
                                                </Border>

                                                <Button Content="{Binding TextoBoton}" IsEnabled="{Binding BotonHabilitado}" Style="{StaticResource BtnTinted}" Background="{StaticResource ColClient}" Foreground="#2A0A1C"
                                                        Margin="0,12,0,0" Height="38" FontWeight="Bold" FontSize="12" Click="BtnInstalarTecniClient_Click"/>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TarjetaClient" Property="BorderBrush" Value="#80F472B6"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ─────────────── JUGAR ─────────────── -->
                    <Grid x:Name="VistaJugar" Grid.Row="1" Margin="32,4,32,24" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Pestañas Noticias / Consola (solo con consola de depuración activa) -->
                        <Border x:Name="PanelPestanasJugar" Grid.Row="0" Style="{StaticResource Segmented}" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabNoticiasBtn" GroupName="TabsJugar" IsChecked="True"
                                             Content="{DynamicResource Play_TabNews}" Background="{StaticResource ColPlay}" Style="{StaticResource SegColor}" Click="TabJugar_Click"/>
                                <RadioButton x:Name="TabConsolaBtn" GroupName="TabsJugar"
                                             Content="{DynamicResource Play_TabConsole}" Background="{StaticResource ColConsola}" Style="{StaticResource SegColor}" Click="TabJugar_Click"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <!-- Noticias -->
                            <Viewbox x:Name="VisorNoticias" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="1100">
                                <Grid x:Name="ContenedorNoticia" Width="760" Height="360" MouseEnter="DetenerCarrusel" MouseLeave="IniciarCarrusel">
                                    <Border CornerRadius="18" Margin="10" Opacity="0.35">
                                        <Border.Background>
                                            <ImageBrush x:Name="ImgNoticiaFondoBrush" Stretch="UniformToFill"/>
                                        </Border.Background>
                                        <Border.Effect>
                                            <BlurEffect Radius="40"/>
                                        </Border.Effect>
                                    </Border>

                                    <Border CornerRadius="16" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Background="{StaticResource BgCard}">
                                        <Border CornerRadius="16" ClipToBounds="True">
                                            <Border.Background>
                                                <ImageBrush x:Name="ImgNoticiaBrush" Stretch="UniformToFill"/>
                                            </Border.Background>
                                            <Grid>
                                                <Border CornerRadius="16">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#000E0F12" Offset="0.25"/>
                                                            <GradientStop Color="#B30E0F12" Offset="0.65"/>
                                                            <GradientStop Color="#F20E0F12" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <Grid VerticalAlignment="Bottom" Margin="30,0,24,26">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                                        <TextBlock x:Name="TxtTitulo" Text="{DynamicResource Play_NewsLoadingTitle}" FontSize="26" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                                        <TextBlock x:Name="TxtCuerpo" Text="{DynamicResource Play_NewsLoadingBody}" FontSize="13" Foreground="#D6D9DE" Margin="0,6,0,14" TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis"/>
                                                        <Button x:Name="BtnNoticiaAccion" Style="{StaticResource BtnPrimary}" Content="{DynamicResource Play_NewsJoin}" Click="BtnNoticia_Click"
                                                                Visibility="Visible" HorizontalAlignment="Left" Height="38" Padding="22,0" FontWeight="Bold" FontSize="12"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                        <StackPanel x:Name="PanelPuntos" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <Button Click="BtnAnterior_Click" Width="38" Height="38" Padding="0" Background="#33FFFFFF" Foreground="White">
                                                            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoChevronLeft}" Style="{StaticResource IconPath}"/></Canvas></Viewbox>
                                                        </Button>
                                                        <Button Click="BtnSiguiente_Click" Width="38" Height="38" Padding="0" Margin="8,0,0,0" Background="#33FFFFFF" Foreground="White">
                                                            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoChevronRight}" Style="{StaticResource IconPath}"/></Canvas></Viewbox>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Viewbox>

                            <!-- Consola -->
                            <Grid x:Name="PanelConsola" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Console_Title}" Style="{StaticResource TxtRowTitle}" FontSize="16"/>
                                        <TextBlock x:Name="TxtEstadoConsola" Text="{DynamicResource Console_Waiting}" Foreground="{StaticResource TextSub}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="chkAutoScrollConsola" IsChecked="True" Content="{DynamicResource Console_AutoScroll}" Style="{StaticResource CheckPlain}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <Button Content="{DynamicResource Console_Copy}" Style="{StaticResource BtnSecondary}" Click="BtnCopiarConsola_Click" Height="32" Padding="12,0" FontSize="12" Margin="0,0,6,0"/>
                                        <Button Content="{DynamicResource Console_Clear}" Style="{StaticResource BtnSecondary}" Click="BtnLimpiarConsola_Click" Height="32" Padding="12,0" FontSize="12" Margin="0,0,6,0"/>
                                        <Button Content="{DynamicResource Console_OpenLogs}" Style="{StaticResource BtnSecondary}" Click="BtnAbrirLogs_Click" Height="32" Padding="12,0" FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1" Background="#0A0B0D" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                                    <ListBox x:Name="ListaConsola" Background="Transparent" BorderThickness="0" Padding="10"
                                             SelectionMode="Extended" PreviewKeyDown="ListaConsola_PreviewKeyDown"
                                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="2,0"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ColorAccentDim}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Texto}" Foreground="{Binding Pincel}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Barra de lanzamiento -->
                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16,14" CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="{DynamicResource Play_SelectProfile}" Style="{StaticResource TxtField}"/>
                                    <ComboBox x:Name="comboPerfilRapido" Height="46" Width="330" HorizontalAlignment="Left" Background="{StaticResource BgCardAlt}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding IconoPath}" Stretch="UniformToFill"/>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Text="{Binding Nombre}" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <Button x:Name="btnJugar" Grid.Column="1" Height="56" MinWidth="230" Padding="28,0" VerticalAlignment="Bottom"
                                        Content="{DynamicResource Play_BtnPlay}" Style="{StaticResource BtnPrimary}" FontSize="17" FontWeight="Bold" Click="BtnJugar_Click">
                                    <Button.Effect>
                                        <DropShadowEffect Color="#5B8CFF" BlurRadius="22" ShadowDepth="0" Opacity="0.35"/>
                                    </Button.Effect>
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="{StaticResource IcoPlay}" Fill="White" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ─────────────── PERFILES ─────────────── -->
                    <Grid x:Name="VistaPerfiles" Grid.Row="1" Margin="32,4,32,24" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource PageIcon}" Background="{StaticResource ColProfiles}" Tag="{StaticResource IcoProfiles}"/>
                                <TextBlock Text="{DynamicResource Profiles_Title}" Style="{StaticResource TxtPageTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource BtnSecondary}" Height="38" Padding="14,0" Margin="0,0,8,0" Click="BtnImportarPerfil_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="15" Height="15" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoDownload}" Style="{StaticResource IconPath}"/></Canvas></Viewbox>
                                        <TextBlock Text="{DynamicResource Import_Btn}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnTinted}" Background="{StaticResource ColProfiles}" Foreground="#1F1404" Height="38" Padding="14,0" Click="AbrirCrearPerfil_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="15" Height="15" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoPlus}" Style="{StaticResource IconPath}"/></Canvas></Viewbox>
                                        <TextBlock Text="{DynamicResource Profiles_CreateNew}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                            <ItemsControl x:Name="listaPerfilesUI">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="TarjetaPerfil" Width="272" Margin="0,0,14,14" Background="{StaticResource BgCard}" CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource BorderSoft}">
                                            <Grid Margin="16">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="52" Height="52" CornerRadius="12" Background="{StaticResource BgCardAlt}" Margin="0,0,14,0" VerticalAlignment="Center">
                                                        <Border CornerRadius="12">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding IconoPath}" Stretch="UniformToFill"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nombre}" ToolTip="{Binding Nombre}" Foreground="{StaticResource TextMain}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <Border Background="{StaticResource ColorAccentDim}" CornerRadius="5" Padding="7,2" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding Version}" Foreground="{StaticResource ColorAccent}" FontSize="11" FontWeight="Bold"/>
                                                            </Border>
                                                            <Border x:Name="BadgeLoader" Background="{StaticResource BgCardAlt}" CornerRadius="5" Padding="7,2">
                                                                <TextBlock x:Name="TxtLoader" Text="{Binding TipoLoader}" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="Bold"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                                    <TextBlock Text="{Binding DetallesVisuales}" Foreground="{StaticResource TextSub}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Viewbox Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <Canvas Width="24" Height="24"><Path Data="{StaticResource IcoClock}" Stroke="{StaticResource ColorWarning}" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas>
                                                        </Viewbox>
                                                        <TextBlock Text="{Binding TiempoJugadoFormateado}" Foreground="{StaticResource ColorWarning}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Grid Grid.Row="2" Margin="0,14,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Style="{StaticResource BtnIcon}" Width="Auto" ToolTip="{DynamicResource Txt_Editar}" Tag="{Binding}" Click="BtnEditar_Click">
                                                        <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoEdit}" Style="{StaticResource IconPath}"/></Canvas></Viewbox>
                                                    </Button>
                                                    <Button Grid.Column="2" Style="{StaticResource BtnIcon}" Width="Auto" ToolTip="{DynamicResource Txt_Carpeta}" Tag="{Binding}" Click="BtnCarpeta_Click">
                                                        <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoFolder}" Style="{StaticResource IconPath}"/></Canvas></Viewbox>
                                                    </Button>
                                                    <Button Grid.Column="4" Style="{StaticResource BtnIcon}" Width="Auto" ToolTip="{DynamicResource Share_Tooltip}" Tag="{Binding}" Click="BtnCompartir_Click">
                                                        <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoShare}" Style="{StaticResource IconPath}"/></Canvas></Viewbox>
                                                    </Button>
                                                    <Button Grid.Column="6" Style="{StaticResource BtnDanger}" Height="34" Padding="0" ToolTip="{DynamicResource Txt_Eliminar}" Tag="{Binding}" Click="BtnEliminar_Click">
                                                        <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoTrash}" Style="{StaticResource IconPath}"/></Canvas></Viewbox>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TarjetaPerfil" Property="BorderBrush" Value="{StaticResource ColProfiles}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding TipoLoader}" Value="Fabric">
                                                <Setter TargetName="BadgeLoader" Property="Background" Value="#26DBD0B4"/>
                                                <Setter TargetName="TxtLoader" Property="Foreground" Value="#DBD0B4"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TipoLoader}" Value="Forge">
                                                <Setter TargetName="BadgeLoader" Property="Background" Value="#26E8743B"/>
                                                <Setter TargetName="TxtLoader" Property="Foreground" Value="#F0915F"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TipoLoader}" Value="NeoForge">
                                                <Setter TargetName="BadgeLoader" Property="Background" Value="#26F0A030"/>
                                                <Setter TargetName="TxtLoader" Property="Foreground" Value="#F5B655"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TipoLoader}" Value="Quilt">
                                                <Setter TargetName="BadgeLoader" Property="Background" Value="#26A07CFF"/>
                                                <Setter TargetName="TxtLoader" Property="Foreground" Value="#B79BFF"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TipoLoader}" Value="Vanilla">
                                                <Setter TargetName="BadgeLoader" Property="Background" Value="#2622C55E"/>
                                                <Setter TargetName="TxtLoader" Property="Foreground" Value="#4ADE80"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ─────────────── COMPLEMENTOS ─────────────── -->
                    <Grid x:Name="VistaMods" Grid.Row="1" Margin="32,4,32,24" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Cabecera -->
                        <Grid Grid.Row="0" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource PageIcon}" Background="{StaticResource ColMods}" Tag="{StaticResource IcoMods}"/>
                                <TextBlock Text="{DynamicResource Mods_Title}" Style="{StaticResource TxtPageTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource Segmented}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="FuenteModrinthBtn" GroupName="FuenteMods" Tag="Modrinth" IsChecked="True"
                                                 Content="Modrinth" Background="{StaticResource ColModrinth}" Style="{StaticResource SegColor}" Checked="FuenteMods_Checked"/>
                                    <RadioButton x:Name="FuenteCurseForgeBtn" GroupName="FuenteMods" Tag="CurseForge"
                                                 Content="CurseForge" Background="{StaticResource ColCurseForge}" Style="{StaticResource SegColor}" Checked="FuenteMods_Checked"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Perfil destino + versión / loader -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Mods_TargetProfile}" Style="{StaticResource TxtField}"/>
                                <ComboBox x:Name="comboPerfilesMods" Height="42" DisplayMemberPath="Nombre" FontSize="14"
                                          SelectionChanged="ComboPerfilesMods_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                                <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="14,0" Height="42" Margin="0,0,8,0" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Version " Foreground="{StaticResource TextSub}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtModVersion" Text="0.00.0" Foreground="{StaticResource ColPlay}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="badgeLoader" Background="{StaticResource BgCard}" CornerRadius="8" Padding="14,0" Height="42" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Loader " Foreground="{StaticResource TextSub}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtModLoader" Text="Minecraft" Foreground="{StaticResource ColProfiles}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Buscador -->
                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtBuscadorMods" Height="44" FontSize="14" Padding="40,0,12,0" KeyDown="TxtBuscadorMods_KeyDown"/>
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False">
                                <Canvas Width="24" Height="24"><Path Data="{StaticResource IcoSearch}" Stroke="{StaticResource TextSub}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas>
                            </Viewbox>
                            <Button Grid.Column="1" Content="{DynamicResource Mods_BtnSearch}" Style="{StaticResource BtnTinted}" Background="{StaticResource ColMods}" Height="44" MinWidth="130" Margin="10,0,0,0" FontWeight="Bold" Click="BtnBuscarOnline_Click"/>
                        </Grid>

                        <!-- Pestañas + tipo -->
                        <Grid Grid.Row="3">
                            <Rectangle Height="1" Fill="{StaticResource BorderSoft}" VerticalAlignment="Bottom"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <RadioButton x:Name="TabOnlineBtn" IsChecked="True" GroupName="TabsMods" Content="{DynamicResource Mods_TabOnline}" Style="{StaticResource TabUnderline}" Checked="TabOnlineBtn_Checked"/>
                                <RadioButton x:Name="TabInstaladosBtn" GroupName="TabsMods" Content="{DynamicResource Mods_TabInstalled}" Style="{StaticResource TabUnderline}" Checked="TabInstaladosBtn_Checked"/>
                            </StackPanel>
                            <Border Style="{StaticResource Segmented}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TipoModsBtn" GroupName="TipoComplemento" Tag="Mod" IsChecked="True"
                                                 Content="{DynamicResource Addons_TipoMods}" Background="{StaticResource ColMods}" Style="{StaticResource SegColor}" Checked="TipoComplemento_Checked"/>
                                    <RadioButton x:Name="TipoTexturasBtn" GroupName="TipoComplemento" Tag="Textura"
                                                 Content="{DynamicResource Addons_TipoTexturas}" Background="{StaticResource ColTexturas}" Style="{StaticResource SegColor}" Checked="TipoComplemento_Checked"/>
                                    <RadioButton x:Name="TipoShadersBtn" GroupName="TipoComplemento" Tag="Shader"
                                                 Content="{DynamicResource Addons_TipoShaders}" Background="{StaticResource ColShaders}" Style="{StaticResource SegColor}" Checked="TipoComplemento_Checked"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Contenido -->
                        <Grid Grid.Row="4" Margin="0,14,0,0">

                            <Grid x:Name="PanelOnline" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource Mods_FiltroCategoria}" Style="{StaticResource TxtField}"/>
                                            <ComboBox x:Name="comboFiltroCategoria" Height="36" DisplayMemberPath="Texto" SelectedValuePath="Clave" SelectionChanged="Filtro_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource Mods_FiltroVersion}" Style="{StaticResource TxtField}"/>
                                            <ComboBox x:Name="comboFiltroVersion" Height="36" DisplayMemberPath="Texto" SelectedValuePath="Clave" SelectionChanged="Filtro_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel x:Name="panelFiltroLoader" Grid.Column="4">
                                            <TextBlock Text="{DynamicResource Mods_FiltroLoader}" Style="{StaticResource TxtField}"/>
                                            <ComboBox x:Name="comboFiltroLoader" Height="36" DisplayMemberPath="Texto" SelectedValuePath="Clave" SelectionChanged="Filtro_SelectionChanged"/>
                                        </StackPanel>
                                        <Button x:Name="btnResetFiltros" Grid.Column="5" Style="{StaticResource BtnIcon}" Width="36" Height="36" Margin="10,0,0,0" VerticalAlignment="Bottom"
                                                Visibility="Collapsed" ToolTip="{DynamicResource Mods_FiltroReset}" Click="BtnResetFiltros_Click">
                                            <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoReset}" Style="{StaticResource IconPath}"/></Canvas></Viewbox>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="txtAvisoFiltros" Foreground="{StaticResource ColorWarning}" FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtAvisoTipo" Foreground="{StaticResource TextSub}" FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <ScrollViewer x:Name="ScrollModsOnline" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="ListaMods_ScrollChanged">
                                        <Border Background="Transparent">
                                            <ListBox x:Name="listaModsGestor" Background="Transparent" BorderThickness="0"
                                                     PreviewMouseWheel="listaMods_PreviewMouseWheel"
                                                     ItemContainerStyle="{StaticResource ItemPlano}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.CanContentScroll="False">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="ContenedorFila" Width="252" Height="196" Margin="0,0,12,12" Background="{StaticResource BgCard}" CornerRadius="14" Padding="14" BorderThickness="1" BorderBrush="{StaticResource BorderSoft}">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <Grid Grid.Row="0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border CornerRadius="10" Width="48" Height="48" Background="{StaticResource BgCardAlt}" Margin="0,0,12,0" VerticalAlignment="Top">
                                                                        <Image Source="{Binding icon_url}" Stretch="UniformToFill" Width="48" Height="48">
                                                                            <Image.Clip>
                                                                                <RectangleGeometry Rect="0,0,48,48" RadiusX="10" RadiusY="10"/>
                                                                            </Image.Clip>
                                                                        </Image>
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding title}" ToolTip="{Binding title}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding author}" Foreground="{StaticResource TextSub}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                            <Viewbox Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                                <Canvas Width="24" Height="24"><Path Data="{StaticResource IcoDownload}" Stroke="{StaticResource TextSub}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas>
                                                                            </Viewbox>
                                                                            <TextBlock Text="{Binding DescargasTexto}" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                            <Border x:Name="BadgeRecomendado" Background="#26F5A524" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" Visibility="Collapsed">
                                                                                <TextBlock Text="{DynamicResource Mods_Recommended}" Foreground="{StaticResource ColorWarning}" FontSize="9" FontWeight="Bold"/>
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <TextBlock Grid.Row="1" Text="{Binding description}" Foreground="{StaticResource TextSub}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="50" Margin="0,10,0,0" VerticalAlignment="Top"/>

                                                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button Grid.Column="0" x:Name="BtnInstalar" Content="{Binding BotonTexto}" Tag="{Binding}" Click="BtnInstalarRapido_Click"
                                                                            IsEnabled="{Binding PuedeInstalar}" Height="34" Background="{StaticResource ColMods}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                                                    <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Content="⋯" Tag="{Binding}" Click="BtnVerVersiones_Click"
                                                                            ToolTip="{DynamicResource Mods_verVersiones}" Width="38" Margin="8,0,0,0" FontWeight="Bold" FontSize="16"/>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>

                                                        <DataTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ContenedorFila" Property="BorderBrush" Value="#80A07CFF"/>
                                                                <Setter TargetName="ContenedorFila" Property="Background" Value="#1A1C22"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding esRecomendado}" Value="True">
                                                                <Setter TargetName="BadgeRecomendado" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="ContenedorFila" Property="BorderBrush" Value="#66F5A524"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding instalando}" Value="True">
                                                                <Setter TargetName="BtnInstalar" Property="Background" Value="#2E3442"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding estaInstalado}" Value="True">
                                                                <Setter TargetName="BtnInstalar" Property="Background" Value="#1F9D55"/>
                                                                <Setter TargetName="ContenedorFila" Property="BorderBrush" Value="#5522C55E"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </ScrollViewer>

                                    <TextBlock x:Name="txtEstadoMods" Foreground="{StaticResource TextSub}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="30" Visibility="Collapsed" IsHitTestVisible="False"/>
                                </Grid>
                            </Grid>

                            <Grid x:Name="PanelInstalados" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="txtContadorInstalados" Grid.Row="0" Foreground="{StaticResource TextSub}" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,10"/>

                                <Grid Grid.Row="1">
                                    <ListBox x:Name="listaModsInstaladosGestor" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="bdr" Background="{StaticResource BgCard}" CornerRadius="10" Padding="14,10" Margin="0,0,4,6" BorderThickness="1" BorderBrush="{StaticResource BorderSoft}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                                                                    <Setter TargetName="bdr" Property="Background" Value="#1A1C22"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="IconoMod" Grid.Column="0" CornerRadius="9" Width="38" Height="38" Background="{StaticResource BgCardAlt}" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding Icono}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel x:Name="InfoMod" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding Titulo}" ToolTip="{Binding NombreArchivo}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Detalle}" Foreground="{StaticResource TextSub}" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" Style="{StaticResource SwitchModStyle}" IsChecked="{Binding Habilitado, Mode=OneWay}" Tag="{Binding}"
                                                              Click="SwitchMod_Click" Margin="0,0,14,0" ToolTip="{DynamicResource Mods_SwitchTooltip}"/>
                                                    <Button Grid.Column="3" Content="{DynamicResource Mods_Delete}" Style="{StaticResource BtnDanger}" Tag="{Binding}" Click="BtnEliminarModLocal_Click"
                                                            Height="30" Padding="12,0" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Habilitado}" Value="False">
                                                        <Setter TargetName="InfoMod" Property="Opacity" Value="0.45"/>
                                                        <Setter TargetName="IconoMod" Property="Opacity" Value="0.45"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock x:Name="txtVacioInstalados" Text="{DynamicResource Mods_SinInstalados}" Foreground="{StaticResource TextSub}" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Selector de versiones de un mod -->
                    <Grid x:Name="OverlayVersiones" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Background="#B3000000" IsHitTestVisible="True" Panel.ZIndex="999">
                        <Border Width="600" Height="540" Style="{StaticResource ModalCard}">
                            <Grid Margin="28">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                    <TextBlock x:Name="txtNombreModVersiones" Text="{DynamicResource Txt_VersionesDisponibles}" Style="{StaticResource TxtPageTitle}" FontSize="20" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="Mods_DesDes" Text="{DynamicResource Mods_DesDes}" Style="{StaticResource TxtPageSub}"/>
                                </StackPanel>

                                <ListView x:Name="listaArchivosVersion" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Margin" Value="0,0,4,6"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="bdr" Background="{StaticResource BgCard}" CornerRadius="10" Padding="14,12" BorderThickness="1" BorderBrush="{StaticResource BorderSoft}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource ColorAccent}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding NombreArchivo}" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <Border Background="{StaticResource BgCardAlt}" CornerRadius="5" Padding="7,2" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Tipo}" Foreground="{Binding ColorTipo}" FontSize="11" FontWeight="Bold"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Fecha}" Foreground="{StaticResource TextSub}" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="1" x:Name="Mods_Install" Content="{DynamicResource Mods_Install}" Style="{StaticResource BtnSecondary}" MinWidth="96" Height="34"
                                                        FontSize="11" FontWeight="Bold" Tag="{Binding}" Click="BtnInstalarVersion_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Button Grid.Row="2" x:Name="Mods_cerrar" Content="{DynamicResource Mods_cerrar}" Style="{StaticResource BtnSecondary}" Margin="0,16,0,0" Height="42" Click="BtnCerrarVersiones_Click"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ─────────────── MODPACKS ─────────────── -->
                    <Grid x:Name="VistaModpacks" Grid.Row="1" Visibility="Collapsed" Margin="32,4,32,24" IsVisibleChanged="VistaModpacks_IsVisibleChanged">

                        <Grid x:Name="PanelBusquedaModpacks" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Style="{StaticResource PageIcon}" Background="{StaticResource ColModpacks}" Tag="{StaticResource IcoModpacks}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource ModPack_Title}" Style="{StaticResource TxtPageTitle}"/>
                                        <TextBlock Text="{DynamicResource ModPack_SubTitle}" Style="{StaticResource TxtPageSub}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Column="1" Style="{StaticResource Segmented}" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="FuenteModpacksModrinthBtn" GroupName="FuenteModpacks" Tag="Modrinth" IsChecked="True"
                                                     Content="Modrinth" Background="{StaticResource ColModrinth}" Style="{StaticResource SegColor}" Checked="FuenteModpacks_Checked"/>
                                        <RadioButton x:Name="FuenteModpacksCurseForgeBtn" GroupName="FuenteModpacks" Tag="CurseForge"
                                                     Content="CurseForge" Background="{StaticResource ColCurseForge}" Style="{StaticResource SegColor}" Checked="FuenteModpacks_Checked"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtBuscadorModpacks" Height="44" FontSize="14" Padding="40,0,12,0" KeyDown="TxtBuscadorModpacks_KeyDown"/>
                                <Viewbox Width="16" Height="16" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False">
                                    <Canvas Width="24" Height="24"><Path Data="{StaticResource IcoSearch}" Stroke="{StaticResource TextSub}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas>
                                </Viewbox>
                                <Button x:Name="btnBuscarModpacks" Grid.Column="1" Content="{DynamicResource Txt_Buscar}" Style="{StaticResource BtnTinted}" Background="{StaticResource ColModpacks}" Foreground="#06201D" Height="44" MinWidth="130" Margin="10,0,0,0" FontWeight="Bold" Click="BtnBuscarModpacks_Click"/>
                            </Grid>

                            <TextBlock x:Name="txtCargandoModpacks" Grid.Row="2" Text="{DynamicResource Txt_BuscandoModpacks}" Foreground="{StaticResource ColorAccent}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,14" Visibility="Collapsed"/>

                            <ScrollViewer Grid.Row="3" x:Name="ScrollModpacks" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="ListaModpacks_ScrollChanged">
                                <ListBox x:Name="listaModpacksUI" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                         ItemContainerStyle="{StaticResource ItemPlano}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="False"
                                         PreviewMouseWheel="listaMods_PreviewMouseWheel">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True" Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="TarjetaModpack" Width="300" Height="158" Background="{StaticResource BgCard}" CornerRadius="14" Margin="0,0,12,12" Padding="14" BorderThickness="1" BorderBrush="{StaticResource BorderSoft}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Border CornerRadius="12" Width="62" Height="62" VerticalAlignment="Top" Background="{StaticResource BgCardAlt}" Margin="0,0,12,0">
                                                        <Border CornerRadius="12">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding IconoUrl}" Stretch="UniformToFill"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Titulo}" Foreground="{StaticResource TextMain}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Autor}" Foreground="{StaticResource TextSub}" FontSize="12" Margin="0,2,0,6" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Descripcion}" Foreground="#B4B9C1" FontSize="11" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource BtnSecondary}" Content="{DynamicResource Txt_VerDetalles}" Foreground="{StaticResource ColModpacks}" HorizontalAlignment="Right"
                                                            Height="30" Padding="14,0" FontWeight="Bold" FontSize="11" Click="BtnVerModpack_Click" Tag="{Binding}"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TarjetaModpack" Property="BorderBrush" Value="#802EC4B6"/>
                                                    <Setter TargetName="TarjetaModpack" Property="Background" Value="#1A1C22"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Grid>

                        <Grid x:Name="PanelDetalleModpack" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button x:Name="btnVolverModpacks" Grid.Row="0" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Height="34" Padding="10,0" Click="BtnVolverModpacks_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoBack}" Style="{StaticResource IconPath}"/></Canvas></Viewbox>
                                    <TextBlock Text="{DynamicResource Txt_VolverBusqueda}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,14" CornerRadius="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border CornerRadius="14" Width="80" Height="80" Background="{StaticResource BgCardAlt}">
                                        <Border CornerRadius="14">
                                            <Border.Background>
                                                <ImageBrush x:Name="imgDetalleModpack" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,18,0">
                                        <TextBlock x:Name="txtDetalleTitulo" Text="Título del Modpack" Style="{StaticResource TxtPageTitle}" FontSize="24" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="txtDetalleAutor" Text="Por Autor" Foreground="{StaticResource TextSub}" FontSize="13" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="comboVersionesModpack" SelectionChanged="ComboVersionesModpack_SelectionChanged" Width="170" Margin="0,0,10,0" Height="44" DisplayMemberPath="NombreAgradable"/>
                                        <Button x:Name="btnInstalarModpack" Content="{DynamicResource Txt_Instalar}" Style="{StaticResource BtnPrimary}" FontWeight="Bold" FontSize="14" Padding="22,0" Height="44" Click="BtnInstalarModpack_Click"/>
                                    </StackPanel>

                                    <StackPanel x:Name="PanelProgresoDescarga" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,18,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="txtEstadoDescarga" Text="{DynamicResource Txt_PreparandoDescarga}" Foreground="{StaticResource TextSub}" FontSize="12" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                        <ProgressBar x:Name="barraDescarga" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource ColorAccent}" Background="{StaticResource BgCardAlt}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Background="{StaticResource BgCard}" CornerRadius="14" ClipToBounds="True" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                                <wv2:WebView2 x:Name="wvDetalleDescripcion" DefaultBackgroundColor="Transparent"/>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ─────────────── AJUSTES ─────────────── -->
                    <Grid x:Name="VistaAjustes" Grid.Row="1" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="32,4,32,28" MaxWidth="820">

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                                    <ContentControl Style="{StaticResource PageIcon}" Background="{StaticResource ColSettings}" Tag="{StaticResource IcoSettings}"/>
                                    <TextBlock Text="{DynamicResource Settings_Title}" Style="{StaticResource TxtPageTitle}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Idioma -->
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8"><Ellipse Width="7" Height="7" Fill="#5B8CFF" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource Settings_Language}" Style="{StaticResource TxtSection}" Foreground="#5B8CFF" Margin="0"/></StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="{DynamicResource Settings_LanguageDesc}" Style="{StaticResource TxtRowTitle}"/>
                                            <TextBlock Text="{DynamicResource Settings_LanguageSub}" Style="{StaticResource TxtRowDesc}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="comboIdiomas" Grid.Column="1" Width="210" Height="38" SelectionChanged="ComboIdiomas_SelectionChanged">
                                            <ComboBoxItem Content="Español" Tag="es-ES" IsSelected="True"/>
                                            <ComboBoxItem Content="English" Tag="en-US"/>
                                            <ComboBoxItem Content="Português (Brasil)" Tag="pt-BR"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- General -->
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8"><Ellipse Width="7" Height="7" Fill="#F5A524" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource Settings_General}" Style="{StaticResource TxtSection}" Foreground="#F5A524" Margin="0"/></StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                                    <StackPanel>
                                        <CheckBox x:Name="chkOcultarLauncher" Style="{StaticResource SettingSwitch}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Settings_HideLauncher}" Style="{StaticResource TxtRowTitle}"/>
                                                <TextBlock Text="{DynamicResource Settings_HideLauncherDesc}" Style="{StaticResource TxtRowDesc}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <Rectangle Style="{StaticResource Divider}"/>
                                        <CheckBox x:Name="chkSnapshots" Style="{StaticResource SettingSwitch}" Click="ChkSnapshots_Click">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Settings_ShowSnapshots}" Style="{StaticResource TxtRowTitle}"/>
                                                <TextBlock Text="{DynamicResource Settings_ShowSnapshotsDesc}" Style="{StaticResource TxtRowDesc}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <!-- Vídeo -->
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8"><Ellipse Width="7" Height="7" Fill="#A07CFF" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource Settings_Video}" Style="{StaticResource TxtSection}" Foreground="#A07CFF" Margin="0"/></StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                <TextBlock Text="{DynamicResource Settings_Resolution}" Style="{StaticResource TxtRowTitle}"/>
                                                <TextBlock Text="{DynamicResource Settings_ResolutionDesc}" Style="{StaticResource TxtRowDesc}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource Settings_Width}" Style="{StaticResource TxtField}" Margin="2,0,0,4"/>
                                                    <TextBox x:Name="txtResAncho" Width="72" Height="34" Text="854" Padding="0" HorizontalContentAlignment="Center"
                                                             TextChanged="TxtRes_TextChanged" PreviewTextInput="SoloNumeros_PreviewTextInput"/>
                                                </StackPanel>
                                                <TextBlock Text="×" Foreground="{StaticResource TextSub}" VerticalAlignment="Bottom" Margin="10,0,10,8" FontSize="14"/>
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource Settings_Height}" Style="{StaticResource TxtField}" Margin="2,0,0,4"/>
                                                    <TextBox x:Name="txtResAlto" Width="72" Height="34" Text="480" Padding="0" HorizontalContentAlignment="Center"
                                                             TextChanged="TxtRes_TextChanged" PreviewTextInput="SoloNumeros_PreviewTextInput"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <Rectangle Style="{StaticResource Divider}"/>
                                        <CheckBox x:Name="chkFullscreen" Style="{StaticResource SettingSwitch}" Click="ChkFullscreen_Click">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Settings_Fullscreen}" Style="{StaticResource TxtRowTitle}"/>
                                                <TextBlock Text="{DynamicResource Settings_FullscreenDesc}" Style="{StaticResource TxtRowDesc}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <!-- Almacenamiento -->
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8"><Ellipse Width="7" Height="7" Fill="#2EC4B6" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource Settings_Storage}" Style="{StaticResource TxtSection}" Foreground="#2EC4B6" Margin="0"/></StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                            <TextBlock Text="{DynamicResource Settings_ClearCache}" Style="{StaticResource TxtRowTitle}"/>
                                            <TextBlock Text="{DynamicResource Settings_ClearCacheDesc}" Style="{StaticResource TxtRowDesc}"/>
                                            <TextBlock x:Name="TxtTamanoCache" Foreground="{StaticResource ColorAccent}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnLimpiarCache" Grid.Column="1" Content="{DynamicResource Settings_ClearCacheBtn}" Style="{StaticResource BtnSecondary}" Height="38" MinWidth="150" Click="BtnLimpiarCache_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Depuración -->
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8"><Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource Settings_Debug}" Style="{StaticResource TxtSection}" Foreground="#22C55E" Margin="0"/></StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                                    <CheckBox x:Name="chkConsola" Style="{StaticResource SettingSwitch}" Click="ChkConsola_Click">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Settings_DebugConsole}" Style="{StaticResource TxtRowTitle}"/>
                                            <TextBlock Text="{DynamicResource Settings_DebugConsoleDesc}" Style="{StaticResource TxtRowDesc}"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>

                                <!-- Integraciones -->
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8"><Ellipse Width="7" Height="7" Fill="#7C87F5" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource Settings_Integrations}" Style="{StaticResource TxtSection}" Foreground="#7C87F5" Margin="0"/></StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                                    <CheckBox x:Name="chkDiscordRpc" Style="{StaticResource SettingSwitch}" Click="ChkDiscordRpc_Click">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Settings_DiscordRpc}" Style="{StaticResource TxtRowTitle}"/>
                                            <TextBlock Text="{DynamicResource Settings_DiscordRpcDesc}" Style="{StaticResource TxtRowDesc}"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>

                                <!-- Personalización -->
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8"><Ellipse Width="7" Height="7" Fill="#F472B6" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource Settings_Customization}" Style="{StaticResource TxtSection}" Foreground="#F472B6" Margin="0"/></StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,26">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="210"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,22,0">
                                            <TextBlock Text="{DynamicResource Settings_SkinTitle}" Style="{StaticResource TxtRowTitle}"/>
                                            <TextBlock Text="{DynamicResource Settings_SkinDesc}" Style="{StaticResource TxtRowDesc}" Margin="0,3,0,18"/>

                                            <Border x:Name="ZonaSkin" Height="110" CornerRadius="12" Cursor="Hand" BorderThickness="1" MouseLeftButtonDown="ZonaSkin_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource BgSidebar}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource ColorAccent}"/>
                                                                <Setter Property="Background" Value="{StaticResource ColorAccentDim}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Viewbox Width="22" Height="22" Margin="0,0,0,8">
                                                        <Canvas Width="24" Height="24"><Path Data="{StaticResource IcoUpload}" Stroke="{StaticResource ColorAccent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas>
                                                    </Viewbox>
                                                    <TextBlock Text="{DynamicResource Settings_UploadSkin}" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource Settings_ElySub}" Foreground="{StaticResource TextSub}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Button Margin="0,12,0,0" Height="38" Style="{StaticResource BtnDanger}" Click="BtnBorrarSkin_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="14" Height="14" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IcoReset}" Style="{StaticResource IconPath}"/></Canvas></Viewbox>
                                                    <TextBlock Text="{DynamicResource Settings_DeleteSkin}" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" ClipToBounds="True" Height="236" VerticalAlignment="Top">
                                            <Grid>
                                                <wv2:WebView2 x:Name="VisorSkinWebView" DefaultBackgroundColor="Transparent"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="TxtVersionAjustes" Text="TecniLauncher v..." Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ═══════════════════════════ LOGIN ═══════════════════════════ -->
                <Grid x:Name="GridLogin" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#B3000000">
                    <Border Width="390" MinHeight="440" Style="{StaticResource ModalCard}">
                        <Grid Margin="34">

                            <StackPanel x:Name="PanelLoginPrincipal" VerticalAlignment="Center" Visibility="Visible">
                                <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource ColorAccentDim}" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <Viewbox Width="22" Height="22">
                                        <Canvas Width="24" Height="24"><Path Data="{StaticResource IcoUser}" Stroke="{StaticResource ColorAccent}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="{DynamicResource Login_Welcome}" Style="{StaticResource TxtPageTitle}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                                <Button x:Name="btnMicrosoft" Content="{DynamicResource Login_Microsoft}" Style="{StaticResource BtnSecondary}" Height="46" FontSize="13" Click="BtnMicrosoft_Click" Margin="0,0,0,8">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Grid Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                    </Grid.RowDefinitions>
                                                    <Rectangle Fill="#F25022" Margin="0.6"/>
                                                    <Rectangle Fill="#7FBA00" Grid.Column="1" Margin="0.6"/>
                                                    <Rectangle Fill="#00A4EF" Grid.Row="1" Margin="0.6"/>
                                                    <Rectangle Fill="#FFB900" Grid.Column="1" Grid.Row="1" Margin="0.6"/>
                                                </Grid>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>

                                <Button x:Name="btnAbrirTecni" Content="{DynamicResource CuentaEly}" Style="{StaticResource BtnSecondary}" Height="46" FontSize="13" Click="BtnLoginTecni_Click"/>

                                <Button x:Name="btnCerrarSesionTecni" Content="{DynamicResource CuentaEly_Cerrar}" Style="{StaticResource BtnDanger}" Height="46" FontSize="13" Click="BtnCerrarSesionTecni_Click" Margin="0,8,0,0" Visibility="Collapsed"/>

                                <Grid Margin="0,20,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Height="1" Fill="{StaticResource BorderStrong}"/>
                                    <TextBlock Text="{DynamicResource Login_OfflineTitle}" Grid.Column="1" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center"/>
                                    <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource BorderStrong}"/>
                                </Grid>

                                <TextBlock Text="{DynamicResource Login_Username}" Style="{StaticResource TxtField}"/>
                                <TextBox x:Name="txtOfflineName" Height="44" FontSize="14" Text="{DynamicResource Login_PlayerPlaceholder}"/>

                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="{DynamicResource Login_Enter}" Grid.Column="0" Height="46" Style="{StaticResource BtnPrimary}" FontWeight="Bold" Click="BtnEntrarLauncher_Click"/>
                                    <Button Content="✕" Grid.Column="2" Height="46" Padding="0" Style="{StaticResource BtnSecondary}" Click="BtnCerrarLogin_Click"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="PanelLoginTecni" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource CuentaEly_iniciar}" Style="{StaticResource TxtPageTitle}" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource CuentaEly_Creden}" Style="{StaticResource TxtPageSub}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,24"/>

                                <TextBlock Text="{DynamicResource CuentaEly_Correo}" Style="{StaticResource TxtField}"/>
                                <TextBox x:Name="txtUsuarioTecni" Height="44" FontSize="14" Margin="0,0,0,14"/>

                                <TextBlock Text="{DynamicResource CuentaEly_Contra}" Style="{StaticResource TxtField}"/>
                                <PasswordBox x:Name="txtPasswordTecni" Height="44" FontSize="14" Margin="0,0,0,18"/>

                                <TextBlock x:Name="txtEstadoTecni" Text="" Foreground="{StaticResource ColorDanger}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

                                <Button x:Name="btnLoginTecni" Content="{DynamicResource CuentaEly_Entrar}" Style="{StaticResource BtnPrimary}" Height="46" FontWeight="Bold" Click="BtnLoginTecniStudio_Click"/>
                                <Button x:Name="btnCancelarTecni" Content="{DynamicResource CuentaEly_atras}" Style="{StaticResource BtnGhost}" Height="34" Margin="0,10,0,0" Click="BtnCancelarTecni_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════ CREAR / EDITAR PERFIL ═══════════════════════════ -->
                <Grid x:Name="GridCrearPerfil" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#B3000000">
                    <Border Width="440" Style="{StaticResource ModalCard}">
                        <StackPanel Margin="28,24">
                            <TextBlock Text="{DynamicResource Config_Title}" Style="{StaticResource TxtPageTitle}" FontSize="18" Margin="0,0,0,20"/>

                            <TextBlock Text="{DynamicResource Config_Name}" Style="{StaticResource TxtField}"/>
                            <TextBox x:Name="txtNombrePerfil" Height="40" FontSize="14"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Config_Loader}" Style="{StaticResource TxtField}"/>
                                    <ComboBox x:Name="comboLoader" Height="40" SelectionChanged="ComboLoader_SelectionChanged">
                                        <ComboBoxItem Content="Vanilla" IsSelected="True"/>
                                        <ComboBoxItem Content="Forge"/>
                                        <ComboBoxItem Content="Fabric"/>
                                        <ComboBoxItem Content="NeoForge"/>
                                        <ComboBoxItem Content="Quilt"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Config_Version}" Style="{StaticResource TxtField}"/>
                                    <ComboBox x:Name="comboVersiones" Height="40" SelectionChanged="ComboVersiones_SelectionChanged"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="lblLoaderVersion" Text="{DynamicResource Config_LoaderVer}" Style="{StaticResource TxtField}" Margin="2,14,0,6" Visibility="Collapsed"/>
                            <ComboBox x:Name="comboLoaderVersion" IsEnabled="False" Visibility="Collapsed" Height="38"/>

                            <Grid Margin="0,16,0,6">
                                <TextBlock Text="{DynamicResource Config_Ram}" Style="{StaticResource TxtField}" Margin="2,0,0,0"/>
                                <TextBlock x:Name="lblRam" Text="2 GB" Foreground="{StaticResource ColorAccent}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="sliderRam" Minimum="1" Maximum="16" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderRam_ValueChanged"/>

                            <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="12,10" Margin="0,14,0,0" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                                    Visibility="{Binding Visibility, ElementName=chkModoRendimiento}">
                                <CheckBox x:Name="chkModoRendimiento" Style="{StaticResource SettingSwitch}" Content="{DynamicResource Config_flags}" FontWeight="SemiBold" FontSize="13" Visibility="Collapsed"/>
                            </Border>

                            <TextBlock Text="{DynamicResource Config_Icon}" Style="{StaticResource TxtField}" Margin="2,16,0,6"/>
                            <ListBox x:Name="listaIconos" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Width="380" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="border" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" Background="Transparent" Padding="2" Margin="1">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{StaticResource BgHover}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ColorAccent}"/>
                                                            <Setter TargetName="border" Property="Background" Value="{StaticResource ColorAccentDim}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBoxItem Tag="icon1.png"><Border Width="28" Height="28" CornerRadius="7"><Border.Background><ImageBrush ImageSource="/Resources/Icons/icon1.png"/></Border.Background></Border></ListBoxItem>
                                <ListBoxItem Tag="icon2.png"><Border Width="28" Height="28" CornerRadius="7"><Border.Background><ImageBrush ImageSource="/Resources/Icons/icon2.png"/></Border.Background></Border></ListBoxItem>
                                <ListBoxItem Tag="icon3.png"><Border Width="28" Height="28" CornerRadius="7"><Border.Background><ImageBrush ImageSource="/Resources/Icons/icon3.png"/></Border.Background></Border></ListBoxItem>
                                <ListBoxItem Tag="icon4.png"><Border Width="28" Height="28" CornerRadius="7"><Border.Background><ImageBrush ImageSource="/Resources/Icons/icon4.png"/></Border.Background></Border></ListBoxItem>
                                <ListBoxItem Tag="icon5.png"><Border Width="28" Height="28" CornerRadius="7"><Border.Background><ImageBrush ImageSource="/Resources/Icons/icon5.png"/></Border.Background></Border></ListBoxItem>
                                <ListBoxItem Tag="icon6.png"><Border Width="28" Height="28" CornerRadius="7"><Border.Background><ImageBrush ImageSource="/Resources/Icons/icon6.png"/></Border.Background></Border></ListBoxItem>
                                <ListBoxItem Tag="icon7.png"><Border Width="28" Height="28" CornerRadius="7"><Border.Background><ImageBrush ImageSource="/Resources/Icons/icon7.png"/></Border.Background></Border></ListBoxItem>
                                <ListBoxItem Tag="icon8.png"><Border Width="28" Height="28" CornerRadius="7"><Border.Background><ImageBrush ImageSource="/Resources/Icons/icon8.png"/></Border.Background></Border></ListBoxItem>
                                <ListBoxItem Tag="icon9.png"><Border Width="28" Height="28" CornerRadius="7"><Border.Background><ImageBrush ImageSource="/Resources/Icons/icon9.png"/></Border.Background></Border></ListBoxItem>
                                <ListBoxItem Tag="icon10.png"><Border Width="28" Height="28" CornerRadius="7"><Border.Background><ImageBrush ImageSource="/Resources/Icons/icon10.png"/></Border.Background></Border></ListBoxItem>
                            </ListBox>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{DynamicResource Btn_Cancel}" Height="42" Style="{StaticResource BtnSecondary}" Click="BtnCancelarPerfil_Click"/>
                                <Button Grid.Column="2" Content="{DynamicResource Btn_Save}" Height="42" Style="{StaticResource BtnPrimary}" FontWeight="Bold" Click="BtnGuardarPerfil_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════ CARGA ═══════════════════════════ -->
                <Grid x:Name="PanelCarga" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#E00E0F12" Panel.ZIndex="999">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="txtEstadoCarga" Text="{DynamicResource Msg_Loading}" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <ProgressBar x:Name="barraCarga" IsIndeterminate="True" Width="280" Height="6" Background="{StaticResource BgCardAlt}" Foreground="{StaticResource ColorAccent}"/>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════ COMPARTIR ═══════════════════════════ -->
                <Grid x:Name="GridCompartir" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#B3000000" Panel.ZIndex="900">
                    <Border Width="420" Style="{StaticResource ModalCard}">
                        <StackPanel Margin="28,24">
                            <TextBlock Text="{DynamicResource Share_Title}" Style="{StaticResource TxtPageTitle}" FontSize="18" Margin="0,0,0,18"/>

                            <StackPanel x:Name="PanelCompartirOpciones">
                                <TextBlock Text="{DynamicResource Share_Incluir}" Style="{StaticResource TxtField}" Margin="2,0,0,10"/>
                                <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="14,4" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,10">
                                            <TextBlock Text="{DynamicResource Share_Mods}" Foreground="{StaticResource TextMain}" FontSize="14" VerticalAlignment="Center"/>
                                            <CheckBox x:Name="chkCompartirMods" Style="{StaticResource SwitchModStyle}" IsChecked="True" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Rectangle Height="1" Fill="{StaticResource BorderSoft}"/>
                                        <Grid Margin="0,10">
                                            <TextBlock Text="{DynamicResource Share_Shaders}" Foreground="{StaticResource TextMain}" FontSize="14" VerticalAlignment="Center"/>
                                            <CheckBox x:Name="chkCompartirShaders" Style="{StaticResource SwitchModStyle}" IsChecked="False" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Rectangle Height="1" Fill="{StaticResource BorderSoft}"/>
                                        <Grid Margin="0,10">
                                            <TextBlock Text="{DynamicResource Share_Texturas}" Foreground="{StaticResource TextMain}" FontSize="14" VerticalAlignment="Center"/>
                                            <CheckBox x:Name="chkCompartirTexturas" Style="{StaticResource SwitchModStyle}" IsChecked="False" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="btnGenerarCodigo" Content="{DynamicResource Share_Generar}" Style="{StaticResource BtnPrimary}" Height="42" Margin="0,14,0,0" FontWeight="Bold" Click="BtnGenerarCodigo_Click"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelCompartirCargando" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource Share_Generando}" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <ProgressBar IsIndeterminate="True" Height="4"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelCompartirResultado" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource Share_CodigoLabel}" Style="{StaticResource TxtField}"/>
                                <TextBox x:Name="txtCodigoCompartir" IsReadOnly="True" Height="68" Background="{StaticResource BgCard}" Foreground="{StaticResource ColorAccent}"
                                         FontSize="34" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas" HorizontalContentAlignment="Center" Padding="0"/>
                                <TextBlock x:Name="txtResumenCompartir" Foreground="{StaticResource TextSub}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>

                                <Border Background="#1AF5A524" BorderBrush="#40F5A524" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,14,0,0">
                                    <TextBlock Text="{DynamicResource Share_Aviso}" Foreground="{StaticResource ColorWarning}" FontSize="12" TextWrapping="Wrap"/>
                                </Border>

                                <Button x:Name="btnCopiarCodigo" Content="{DynamicResource Share_Copiar}" Style="{StaticResource BtnPrimary}" Height="42" Margin="0,14,0,0" FontWeight="Bold" Click="BtnCopiarCodigo_Click"/>
                            </StackPanel>

                            <Button Content="{DynamicResource Share_Cerrar}" Style="{StaticResource BtnSecondary}" Height="40" Margin="0,10,0,0" Click="BtnCerrarCompartir_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════ IMPORTAR ═══════════════════════════ -->
                <Grid x:Name="GridImportar" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#B3000000" Panel.ZIndex="900">
                    <Border Width="420" Style="{StaticResource ModalCard}">
                        <StackPanel Margin="28,24">
                            <TextBlock Text="{DynamicResource Import_Title}" Style="{StaticResource TxtPageTitle}" FontSize="18" Margin="0,0,0,18"/>

                            <TextBlock Text="{DynamicResource Import_CodigoLabel}" Style="{StaticResource TxtField}"/>
                            <TextBox x:Name="txtCodigoImportar" Height="60" MaxLength="6" FontSize="28" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas" Padding="0"
                                     HorizontalContentAlignment="Center" PreviewTextInput="SoloNumeros_PreviewTextInput" KeyDown="TxtCodigoImportar_KeyDown"/>

                            <StackPanel x:Name="PanelProgresoImportar" Visibility="Collapsed" Margin="0,16,0,0">
                                <TextBlock x:Name="txtEstadoImportar" Foreground="{StaticResource TextSub}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                <ProgressBar x:Name="barraImportar" Height="5" IsIndeterminate="True"/>
                            </StackPanel>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{DynamicResource Btn_Cancel}" Style="{StaticResource BtnSecondary}" Height="42" Click="BtnCancelarImportar_Click"/>
                                <Button x:Name="btnConfirmarImportar" Grid.Column="2" Content="{DynamicResource Import_Confirmar}" Style="{StaticResource BtnPrimary}" Height="42" FontWeight="Bold" Click="BtnConfirmarImportar_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════ AVISO FLOTANTE ═══════════════════════════ -->
                <Border x:Name="ToastGlobal" Grid.ColumnSpan="2" Panel.ZIndex="1000" Visibility="Collapsed" IsHitTestVisible="False"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" MaxWidth="420"
                        Background="{StaticResource BgCardAlt}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="24" Opacity="0.5" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="3" CornerRadius="1.5" Background="{StaticResource ColorAccent}" Margin="10,12,0,12"/>
                        <StackPanel Grid.Column="1" Margin="12,12,16,12">
                            <TextBlock x:Name="txtToast" Foreground="{StaticResource TextMain}" FontSize="13" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="barraToast" IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
